// Prisma schema for makcom-ads — BASE DB
// Holds: auth (User/Tenant/TenantUser), OAuth state, run logs (MakeJob/AuditLog).
// BI fact tables and Meta domain objects live in per-project DBs (see prisma/project-schema/schema.prisma).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ===== Auth / Multi-tenancy =====

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships   TenantUser[]
  auditLogs     AuditLog[]
}

// A "tenant" represents a project — has its own dedicated database (dbName).
// Renamed conceptually to "project" in UI; model name kept as Tenant for backward
// compatibility with existing tenantId columns.
model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique           // e.g., "tenniix" — URL-safe identifier
  dbName      String   @unique           // e.g., "tenniix_mshop" — actual MySQL database name
  status      String   @default("active") // active | archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members        TenantUser[]
  auditLogs      AuditLog[]
  makeJobs       MakeJob[]
}

enum TenantRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model TenantUser {
  id        String     @id @default(cuid())
  tenantId  String
  userId    String
  role      TenantRole @default(MEMBER)
  createdAt DateTime   @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

// ===== OAuth state nonce (Meta connect flow) =====

model OAuthState {
  state     String   @id @db.VarChar(96)
  tenantId  String
  userId    String?
  purpose   String   @default("meta_connect")
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

// ===== Observability (cross-project; stays in base DB) =====

model MakeJob {
  id         String   @id @default(cuid())
  tenantId   String
  scenario   String
  status     String   // pending | success | error
  request    Json
  response   Json?
  error      String?  @db.Text
  durationMs Int?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([scenario, status])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  payload   Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}
