// Prisma schema for makcom-ads — BASE DB
// Holds: auth (User/Tenant/TenantUser), OAuth state, run logs (MakeJob/AuditLog).
// BI fact tables and Meta domain objects live in per-project DBs (see prisma/project-schema/schema.prisma).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ===== Auth / Multi-tenancy =====

enum UserRole {
  USER         // regular user — must request + be granted access per project
  SUPER_ADMIN  // can view all projects, approve/reject access requests
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String?
  role          UserRole @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships          TenantUser[]
  auditLogs            AuditLog[]
  accessRequests       ProjectAccessRequest[] @relation("requester")
  reviewedRequests     ProjectAccessRequest[] @relation("reviewer")
}

// A "tenant" represents a project — has its own dedicated database (dbName).
// Renamed conceptually to "project" in UI; model name kept as Tenant for backward
// compatibility with existing tenantId columns.
model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique           // e.g., "tenniix" — URL-safe identifier
  dbName      String   @unique           // e.g., "tenniix_mshop" — actual MySQL database name
  status      String   @default("active") // active | archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members          TenantUser[]
  auditLogs        AuditLog[]
  makeJobs         MakeJob[]
  accessRequests   ProjectAccessRequest[]
  groupMemberships ProjectGroupMember[]
}

// Aggregated view across multiple projects (e.g. "WOMO 全部门店" rolls up the
// 5 WOMO shop tenants). All stored values are assumed to be in the same base
// currency (USD) — Make scenarios convert at ingest time.
model ProjectGroup {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   ProjectGroupMember[]
}

model ProjectGroupMember {
  id        String   @id @default(cuid())
  groupId   String
  tenantId  String
  createdAt DateTime @default(now())

  group  ProjectGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([groupId, tenantId])
  @@index([tenantId])
}

// ===== Project access requests =====
// A regular USER applies for a project; a SUPER_ADMIN approves or rejects.
// On approve, a TenantUser row is created and the request is marked approved.

model ProjectAccessRequest {
  id          String    @id @default(cuid())
  userId      String
  tenantId    String
  status      String    @default("pending")  // pending | approved | rejected
  message     String?   @db.Text             // optional note from the requester
  reviewNote  String?   @db.Text             // optional note from the reviewer
  requestedAt DateTime  @default(now())
  reviewedAt  DateTime?
  reviewerId  String?

  user     User    @relation("requester", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User?   @relation("reviewer",  fields: [reviewerId], references: [id], onDelete: SetNull)
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([status, requestedAt])
  @@index([tenantId, status])
}

enum TenantRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model TenantUser {
  id        String     @id @default(cuid())
  tenantId  String
  userId    String
  role      TenantRole @default(MEMBER)
  createdAt DateTime   @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

// ===== OAuth state nonce (Meta connect flow) =====

model OAuthState {
  state     String   @id @db.VarChar(96)
  tenantId  String
  userId    String?
  purpose   String   @default("meta_connect")
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

// ===== Observability (cross-project; stays in base DB) =====

model MakeJob {
  id         String   @id @default(cuid())
  tenantId   String
  scenario   String
  status     String   // pending | success | error
  request    Json
  response   Json?
  error      String?  @db.Text
  durationMs Int?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([scenario, status])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  payload   Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}
